{
  "name": "mocktrade-desktop",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "MockTrade desktop app: the same screens in real windows that pop out onto any monitor",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
