# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The name the screens are reached at (its DNS A record points at this server).
# "localhost" works for a try-out on your own machine (Caddy's local certificate).
LADDRIX_DOMAIN=trade.example.in

# Encrypts secrets at rest. Make one with:
#   docker compose -f deploy/compose.yaml run --rm app python -m laddrix.tools.users new-key
LADDRIX_SECRET_KEY=

# sim  = simulated prices; paper accounts only (a safe try-out).
# kite = live Kite prices. Kite accounts trade for real after their daily login (a button on
#        the screen); paper accounts fill against live prices.
LADDRIX_PRICES=sim

# The Kite Connect app (kite mode). In Kite's developer console set its redirect URL to
#   https://<LADDRIX_DOMAIN>/kite/callback
# An account with its own app: KITE_API_KEY_<ACCOUNT ID> / KITE_API_SECRET_<ACCOUNT ID>,
# upper case with - as _, e.g. KITE_API_KEY_ACC_AYUSH.
KITE_API_KEY=
KITE_API_SECRET=

# NSE trading holidays this year (no morning reminders or price alerts on them), e.g.
#   LADDRIX_HOLIDAYS=2026-10-21,2026-11-10
LADDRIX_HOLIDAYS=

# Alerts to your phone: an https:// address that accepts a JSON POST {"text": ...}
# (a Slack incoming webhook, Google Chat or ntfy.sh). Empty = alerts only on the screens.
LADDRIX_ALERT_WEBHOOK=

# The exchange's freeze quantities (the most one order may carry) for futures and options.
# Kite doesn't send them: make a file of `underlying,qty` lines from NSE's latest freeze
# list, copy it into the data volume, then set this. Empty = no freeze limit known.
#   docker compose -f deploy/compose.yaml cp freeze.csv app:/data/freeze.csv
#   LADDRIX_FREEZE_FILE=/data/freeze.csv
LADDRIX_FREEZE_FILE=

# Logs: json (one JSON object a line, with request, user, account and order ids; search them
# with jq, docs/runbooks/monitoring.md) or text (plain lines).
LADDRIX_LOG_FORMAT=json

# Monitoring (optional; docker compose --profile monitoring). Prometheus's own key to read the
# app's metrics. Make one with: openssl rand -hex 32
LADDRIX_METRICS_TOKEN=
# Grafana's admin password (Grafana listens on this machine only; reach it by SSH tunnel).
GRAFANA_ADMIN_PASSWORD=
