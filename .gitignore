# What never goes into git. The screens' own build output: ui/.gitignore.

# Secrets: they live in the environment or a local .env, never here (docs/design/security.md).
.env
*.env
secrets/
kite_token*

# Data a running server or the demo writes: users, the audit trail, recordings, broker tokens.
/data/
*.db
*.db-shm
*.db-wal
*.sqlite3

# Python: caches, builds, virtual environments, tool output.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Browser checks and screenshots made while working (the kept ones are in context/images/).
test-results/
playwright-report/

# Editors and operating systems.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
